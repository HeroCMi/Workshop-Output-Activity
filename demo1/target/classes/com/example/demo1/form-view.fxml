<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo1.FormController">

    <top>
        <Label text="📝 ADD NEW STUDENT" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 10;"/>
    </top>

    <center>
        <VBox spacing="15" style="-fx-padding: 30; -fx-alignment: center;">
            <TextField fx:id="txtName" promptText="Enter Full Name" style="-fx-pref-width: 300;"/>
            <TextField fx:id="txtCourse" promptText="Enter Course (e.g. BSIT)" style="-fx-pref-width: 300;"/>
            <TextField fx:id="txtYear" promptText="Enter Year Level (1-4)" style="-fx-pref-width: 300;"/>

            <HBox spacing="20" style="-fx-alignment: center; -fx-padding-top: 20;">
                <Button text="💾 SAVE" onAction="#saveStudent"
                        style="-fx-font-size: 14; -fx-padding: 8 20; -fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button text="⬅ BACK TO LIST" onAction="#goToList"
                        style="-fx-font-size: 14; -fx-padding: 8 20; -fx-background-color: #9E9E9E; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>