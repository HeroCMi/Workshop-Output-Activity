<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo1.ListController">

    <top>
        <Label text="Student List" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 10;"/>
    </top>

    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn text="ID" fx:id="colId" prefWidth="50"/>
                <TableColumn text="Name" fx:id="colName" prefWidth="200"/>
                <TableColumn text="Course" fx:id="colCourse" prefWidth="150"/>
                <TableColumn text="Year" fx:id="colYear" prefWidth="80"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <!-- ✅ BIG CLEAR BUTTON TO OPEN INPUT SCREEN -->
        <Button text="➕ ADD NEW STUDENT" onAction="#goToForm"
                style="-fx-font-size: 14; -fx-padding: 10 20; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-margin: 10;"/>
    </bottom>

</BorderPane>